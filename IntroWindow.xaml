<Window x:Class="PrivacyShield.IntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivacyShield"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>

        <Style x:Key="Close" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="t" Text="&#215;" FontSize="18" Foreground="#6E6E73"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Foreground" Value="#D0D0D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#8A8A8F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="4"
                        Background="#141416" BorderBrush="#2E2E32" BorderThickness="1">
                                <TextBlock x:Name="tick" Text="&#10003;" FontSize="11" Foreground="#0A0A0B"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#E8E8EA"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#E8E8EA"/>
                                <Setter TargetName="tick" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Continue" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#17171A" BorderBrush="#2A2A2E" BorderThickness="1" CornerRadius="9">
                            <TextBlock Text="I UNDERSTAND, CONTINUE" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="#E8E8EA" FontWeight="SemiBold" FontSize="12.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E1E22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E4E6"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="StepBody" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6A6A6F"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>

    </Window.Resources>

    <Border Margin="12" Background="#0A0A0B" CornerRadius="16" BorderBrush="#1B1B1E" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Button x:Name="btnClose" Style="{StaticResource Close}" Click="Close_Click"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0" Panel.ZIndex="1"/>

            <StackPanel Margin="40,40,40,28">

                <Border x:Name="DragZone" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Drag_MouseDown">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" FontSize="24" FontWeight="Light"
                       Foreground="#F2F2F3" Text="PRIVACY SHIELD"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#55555A"
                       Margin="0,7,0,0" Text="Before you start"/>
                        <Border Width="28" Height="2" Background="#2E2E32" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,26,0,0">

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="6" Background="#141416" BorderBrush="#242428" BorderThickness="1" VerticalAlignment="Top">
                            <TextBlock Text="1" Foreground="#8A8A8F" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource StepTitle}" Text="Pick your game build"/>
                            <TextBlock Style="{StaticResource StepBody}" Text="In Arguments, -b3570 is the build number. Match it to the build your server runs, or remove it to use the latest."/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="6" Background="#141416" BorderBrush="#242428" BorderThickness="1" VerticalAlignment="Top">
                            <TextBlock Text="2" Foreground="#8A8A8F" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource StepTitle}" Text="Disable WebRTC means local IP only"/>
                            <TextBlock Style="{StaticResource StepBody}" Text="This hides your local address (like 192.168.x.x) from in-game scripts. Your public internet IP is unaffected, so servers still see it normally."/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="6" Background="#141416" BorderBrush="#242428" BorderThickness="1" VerticalAlignment="Top">
                            <TextBlock Text="3" Foreground="#8A8A8F" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource StepTitle}" Text="Re-run the LAN block after updates"/>
                            <TextBlock Style="{StaticResource StepBody}" Text="FiveM renames its files each update, so after every game update, toggle Block LAN scanning off then on to re-apply the rules."/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="6" Background="#141416" BorderBrush="#242428" BorderThickness="1" VerticalAlignment="Top">
                            <TextBlock Text="4" Foreground="#8A8A8F" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource StepTitle}" Text="Admin only for the firewall"/>
                            <TextBlock Style="{StaticResource StepBody}" Text="The app runs without admin. Only the LAN block asks for elevation, and only when you turn it on."/>
                        </StackPanel>
                    </Grid>

                </StackPanel>

                <CheckBox x:Name="chkDontShow" Style="{StaticResource Check}" Content="Don't show this again"
                  FontSize="11.5" Margin="0,28,0,0"/>

                <Button x:Name="btnContinue" Style="{StaticResource Continue}" Margin="0,18,0,0" Click="Continue_Click"/>

                <TextBlock HorizontalAlignment="Center" FontSize="10.5" Foreground="#44444A" Margin="0,14,0,0"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Text="Privacy hardening for your own machine. Respect the rules of any server you join."/>

            </StackPanel>
        </Grid>
    </Border>
</Window>
